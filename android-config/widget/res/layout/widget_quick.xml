<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_kid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Tribe" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:paddingBottom="2dp" />
    <TextView android:id="@+id/w_open" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ouvrir" android:textSize="12sp" android:textColor="@color/w_accent" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
  </LinearLayout>
  <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="6dp" />
  <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" />
  <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="6dp" />
</LinearLayout>
