<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_btn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:orientation="vertical" android:gravity="center"
    android:background="@drawable/widget_btn_bg" android:minHeight="52dp" android:padding="4dp">
  <TextView android:id="@+id/w_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" />
  <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textSize="11sp" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" />
  <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_on_ink" android:visibility="gone" />
</LinearLayout>
